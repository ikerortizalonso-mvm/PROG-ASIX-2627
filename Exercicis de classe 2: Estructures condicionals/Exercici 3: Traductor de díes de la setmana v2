diaset = input("Día de la setmana: ")


match diaset:
 case "Dilluns":
   print("Traducció: 1")
 case "Dimarts":
   print("Traducció: 2")
 case "Dimecres":
   print("Traducció: 3")
 case "Dijous":
   print("Traducció: 4")
 case "Divendres":
   print("Traducció: 5")
 case "Dissabte":
   print("Traducció: 6")
 case "Diumengue":
   print("Traducció: 7")
 case _:
   print("No hi ha més dies de la setmana. T'has equivocat.")
